# ==============================================================================
# Environment Configuration & Secrets Template for Uchebny Radar
# Copy this file to .env and customize secrets for your environment
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=uchebny_radar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/uchebny_radar

# Application Server Ports
SERVER_PORT=8080
FRONTEND_PORT=80

# Monitoring (Grafana)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your_secure_grafana_password_here

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
