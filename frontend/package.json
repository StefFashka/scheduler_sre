{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start:db": "cd .. && docker compose up -d postgres",
    "start:backend": "cd ../backend && (./mvnw spring-boot:run || mvnw.cmd spring-boot:run || mvn spring-boot:run)",
    "start:frontend": "npm run dev",
    "dev:all": "npm run start:db && concurrently -n \"backend,frontend\" -c \"blue,magenta\" \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
